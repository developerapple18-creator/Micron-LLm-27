  <diagram id="p00" name="00 — الفهرس ودليل القراءة">
    <mxGraphModel dx="1704" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1370" pageHeight="2520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
